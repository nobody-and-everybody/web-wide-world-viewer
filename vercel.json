{
  "rewrites": [
    {
      "source": "/viewer2",
      "destination": "/viewer2/index.html"
    },
    {
      "source": "/viewer",
      "destination": "/viewer/index.html"
    },
    {
      "source": "/spark",
      "destination": "/spark/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/viewer2/:path*",
      "destination": "/viewer2/:path*"
    },
    {
      "source": "/viewer/:path*",
      "destination": "/viewer/:path*"
    },
    {
      "source": "/spark/:path*",
      "destination": "/spark/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}