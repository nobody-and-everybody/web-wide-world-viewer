{
  "redirects": [
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/museum-v1_0_68",
      "destination": "/museum-v1_0_68/index.html"
    },
    {
      "source": "/museum-v1_0_68/viewer2",
      "destination": "/museum-v1_0_68/viewer2/index.html"
    },
    {
      "source": "/museum-v1_0_68/viewer",
      "destination": "/museum-v1_0_68/viewer/index.html"
    },
    {
      "source": "/museum-v1_0_68/spark",
      "destination": "/museum-v1_0_68/spark/index.html"
    },
    {
      "source": "/museum-v1_0_68/(.*)",
      "destination": "/museum-v1_0_68/index.html"
    },
    {
      "source": "/viewer2",
      "destination": "/viewer2/index.html"
    },
    {
      "source": "/viewer",
      "destination": "/viewer/index.html"
    },
    {
      "source": "/spark",
      "destination": "/spark/index.html"
    },

    {
      "source": "/server/(.*)",
      "destination": "/404"
    },
    {
      "source": "/((?!assets|models|sounds|images|favicon|vite\\.svg|robots\\.txt|sitemap\\.xml|og-image\\.png|v2/|viewer2/|viewer/|spark/|museum-v1_0_68/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}