  "list": [
    {
      "id": "npc_centurion_marcus",
      "modelId": "soldier",
      "position": { "x": 3, "y": 0, "z": -29 },
      "movementPattern": "patrol",
      "patrolPoints": [
        { "x": 15, "y": 0, "z": -40 },
        { "x": 20, "y": 0, "z": -40 },
        { "x": 20, "y": 0, "z": -45 },
        { "x": 15, "y": 0, "z": -45 }
      ],
      "wanderSpeed": 0.5,
      "interaction": {
        "type": "guard",
        "distance": 2.5,
        "autoTrigger": true,
        "hintText": "🎉 新年快乐",
        "dialogues": [
          {
            "id": "greeting",
            "text": "新年好，公民！我是百夫长马库斯。农神节快乐！今天即使是我这样的军人，也可以放松一下了。",
            "responses": [
              {
                "id": "ask_saturnalia",
                "text": "农神节是什么节日？"
              },
              {
                "id": "ask_celebration",
                "text": "罗马人怎么庆祝新年？"
              },
              {
                "id": "ask_wish",
                "text": "您的新年愿望是什么？"
              },
              {
                "id": "goodbye",
                "text": "新年快乐，马库斯！"
              }
            ]
          },
          {
            "id": "ask_saturnalia",
            "text": "农神节是罗马最盛大的节日！为了纪念农神萨图恩，我们要庆祝整整七天。在这几天里，主人会为奴隶服务，所有人都平等。这是一年中最欢乐的时刻！",
            "responses": [
              {
                "id": "ask_celebration",
                "text": "具体有什么庆祝活动？"
              },
              {
                "id": "ask_gift",
                "text": "会互送礼物吗？"
              },
              {
                "id": "goodbye",
                "text": "真是美好的节日！"
              }
            ]
          },
          {
            "id": "ask_celebration",
            "text": "庆祝方式可多了！首先要点燃蜡烛驱散黑暗，象征光明战胜黑暗。然后是盛大的宴会，街上到处都是歌舞。今晚广场上还有篝火晚会，斗兽场也有特别表演！",
            "responses": [
              {
                "id": "ask_gift",
                "text": "需要准备什么礼物吗？"
              },
              {
                "id": "ask_wish",
                "text": "您有什么新年愿望？"
              },
              {
                "id": "goodbye",
                "text": "我一定要去看看！"
              }
            ]
          },
          {
            "id": "ask_gift",
            "text": "当然！农神节最重要的传统就是互赠礼物。蜡烛代表光明，小陶偶代表祝福，还有糖果和蜂蜜蛋糕。我已经给战友们准备了酒和橄榄枝，祝他们新年平安。",
            "responses": [
              {
                "id": "receive_gift",
                "text": "我也想送您一份祝福"
              },
              {
                "id": "goodbye",
                "text": "真温馨，新年快乐！"
              }
            ]
          },
          {
            "id": "receive_gift",
            "text": "（爽朗地笑）哈哈！这份心意我收下了！作为回礼，送你这枚护身符——它是马尔斯神庙的祭司开过光的，保佑你新的一年平安顺遂！愿诸神庇佑你！",
            "responses": [
              {
                "id": "greeting",
                "text": "太感谢了！还有其他问题"
              },
              {
                "id": "goodbye",
                "text": "愿诸神也庇佑您！"
              }
            ]
          },
          {
            "id": "ask_wish",
            "text": "我的新年愿望？（眼神变得柔和）希望帝国边疆安宁，不再有战争。我已经二十年没回家乡了...新的一年，希望能见到我的老母亲。也希望罗马永远繁荣昌盛！",
            "responses": [
              {
                "id": "bless_marcus",
                "text": "愿您的愿望成真！"
              },
              {
                "id": "goodbye",
                "text": "一定会实现的！"
              }
            ]
          },
          {
            "id": "bless_marcus",
            "text": "（感动地）谢谢你，年轻人。新的一年，也愿朱庇特保佑你心想事成！现在去享受节日吧，女祭司朱莉娅在神殿举办新年祈福仪式，很值得去看看。",
            "responses": [
              {
                "id": "greeting",
                "text": "好的，还有别的想聊吗？"
              },
              {
                "id": "goodbye",
                "text": "这就去！新年快乐！"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "npc_priestess_julia",
      "modelId": "nightshade",
      "position": { "x": 10, "y": 0, "z": -38 },
      "movementPattern": "idle",
      "interaction": {
        "type": "priest",
        "distance": 2,
        "autoTrigger": true,
        "hintText": "🔥 新年祈福",
        "dialogues": [
          {
            "id": "greeting",
            "text": "新年好，旅行者。愿维斯塔的圣火在新的一年继续照亮你的道路。今天是特别的日子，来参加新年祈福仪式吗？",
            "responses": [
              {
                "id": "ask_blessing",
                "text": "请为我举行新年祈福"
              },
              {
                "id": "ask_ceremony",
                "text": "新年仪式是怎样的？"
              },
              {
                "id": "ask_fire_newyear",
                "text": "圣火在新年有什么特别意义？"
              },
              {
                "id": "goodbye",
                "text": "新年快乐，女祭司"
              }
            ]
          },
          {
            "id": "ask_blessing",
            "text": "（庄严地）闭上眼睛...愿维斯塔的圣火净化你过去一年的烦恼，愿雅努斯为你打开新年的幸运之门，愿福尔图娜女神眷顾你的每一个选择。新年吉祥，愿你万事如意！",
            "responses": [
              {
                "id": "ask_janus",
                "text": "雅努斯是谁？"
              },
              {
                "id": "offer_thanks",
                "text": "我想向神灵献上感谢"
              },
              {
                "id": "goodbye",
                "text": "感谢您的祝福！"
              }
            ]
          },
          {
            "id": "ask_janus",
            "text": "雅努斯是双面神，掌管开始与结束、过去与未来。他的一张脸望着过去，另一张脸看向未来。一月——Januarius，就是以他的名字命名的。新年时，我们要向他祈祷，请他开启幸运之门。",
            "responses": [
              {
                "id": "ask_blessing",
                "text": "请为我向雅努斯祈祷"
              },
              {
                "id": "goodbye",
                "text": "原来如此，感谢您"
              }
            ]
          },
          {
            "id": "ask_ceremony",
            "text": "新年仪式很神圣。首先，我们要用圣水洒扫神殿，象征洗去旧年的尘埃。然后点燃新的圣火，代表新年的希望。最后，每个参与者都会得到一枝月桂，象征胜利与祝福。",
            "responses": [
              {
                "id": "join_ceremony",
                "text": "我想参加仪式"
              },
              {
                "id": "ask_fire_newyear",
                "text": "圣火在新年有什么特别？"
              },
              {
                "id": "goodbye",
                "text": "听起来很神圣"
              }
            ]
          },
          {
            "id": "join_ceremony",
            "text": "（微笑）很好。请跪下，双手合十...（轻声祈祷）维斯塔女神在上，请接纳这位旅行者的虔诚。赐予他/她新年的庇护...（站起身，递过一枝月桂）收好它，这是新年的祝福。",
            "responses": [
              {
                "id": "thank_priestess",
                "text": "我会珍藏这份祝福"
              },
              {
                "id": "goodbye",
                "text": "感谢您，女祭司"
              }
            ]
          },
          {
            "id": "thank_priestess",
            "text": "愿你在新的一年里，像这枝月桂一样常青不败。记住，无论遇到什么困难，只要心中有光明，就没有过不去的黑暗。新年快乐，旅行者。",
            "responses": [
              {
                "id": "greeting",
                "text": "还有其他问题"
              },
              {
                "id": "goodbye",
                "text": "愿圣火永远燃烧！"
              }
            ]
          },
          {
            "id": "ask_fire_newyear",
            "text": "新年的圣火有特别的意义。在旧年的最后一刻，我们会熄灭旧火，然后在新年第一缕阳光中点燃新火。这象征着旧岁已去，新年重生。七百年来，这个仪式从未间断。",
            "responses": [
              {
                "id": "ask_blessing",
                "text": "请用圣火为我祈福"
              },
              {
                "id": "goodbye",
                "text": "真是神圣的传统"
              }
            ]
          },
          {
            "id": "offer_thanks",
            "text": "（欣慰地）感恩之心是最好的供品。把你的感谢写在这块木牌上，挂在神殿的许愿树上。维斯塔女神会看到你的心意。也请为来年许一个愿望吧。",
            "responses": [
              {
                "id": "make_wish",
                "text": "（写下愿望）希望新年一切顺利"
              },
              {
                "id": "goodbye",
                "text": "谢谢您，女祭司"
              }
            ]
          },
          {
            "id": "make_wish",
            "text": "（轻轻点头）你的愿望已经被神灵听到了。记住，愿望不只是祈求，更是承诺。新的一年，努力让愿望成真吧。愿诸神与你同在！",
            "responses": [
              {
                "id": "greeting",
                "text": "我会努力的"
              },
              {
                "id": "goodbye",
                "text": "愿诸神与您同在！"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "npc_gladiator_spartacus",
      "modelId": "sparta",
      "position": { "x": 5, "y": 0, "z": -9 },
      "movementPattern": "wander",
      "wanderRadius": 4,
      "wanderSpeed": 0.4,
      "interaction": {
        "type": "trainer",
        "distance": 2.5,
        "autoTrigger": true,
        "hintText": "⚔️ 新年切磋",
        "dialogues": [
          {
            "id": "greeting",
            "text": "哈！新年快乐，朋友！今天是农神节，连角斗士也能放个假。难得有这样的好日子，来喝一杯庆祝？",
            "responses": [
              {
                "id": "drink_together",
                "text": "好啊，敬新年！"
              },
              {
                "id": "ask_newyear_fight",
                "text": "新年斗兽场有比赛吗？"
              },
              {
                "id": "ask_resolution",
                "text": "您有什么新年计划？"
              },
              {
                "id": "goodbye",
                "text": "新年快乐，斯巴达克斯！"
              }
            ]
          },
          {
            "id": "drink_together",
            "text": "（举起酒杯）敬新年！敬自由！敬所有活过这一年的人！（一饮而尽）哈哈，好酒！这是我用角斗赏金买的最好的葡萄酒。能在新年和朋友共饮，是最大的幸福！",
            "responses": [
              {
                "id": "ask_freedom_newyear",
                "text": "自由人的新年感觉如何？"
              },
              {
                "id": "ask_resolution",
                "text": "新的一年有什么打算？"
              },
              {
                "id": "goodbye",
                "text": "干杯！新年快乐！"
              }
            ]
          },
          {
            "id": "ask_freedom_newyear",
            "text": "（感慨地）这是我作为自由人度过的第三个新年了。还记得在斗兽场的日子，新年只意味着又一场生死搏斗。现在...我可以选择和谁一起庆祝，这就是自由的滋味。",
            "responses": [
              {
                "id": "toast_freedom",
                "text": "为自由干杯！"
              },
              {
                "id": "ask_resolution",
                "text": "那您新年有什么计划？"
              },
              {
                "id": "goodbye",
                "text": "愿自由永远属于您"
              }
            ]
          },
          {
            "id": "toast_freedom",
            "text": "（眼眶微红）为自由！为那些没能等到自由的兄弟们！新的一年，我要资助更多奴隶赎身。每个人都值得拥有自己的新年...自己的人生。",
            "responses": [
              {
                "id": "offer_help_spartacus",
                "text": "我想帮助您"
              },
              {
                "id": "goodbye",
                "text": "您是真正的英雄"
              }
            ]
          },
          {
            "id": "offer_help_spartacus",
            "text": "（握住你的手）谢谢，朋友。这世界需要更多像你这样的人。新的一年，愿我们都能让这个世界变得更好一点。来，再干一杯！为新年，为希望！",
            "responses": [
              {
                "id": "greeting",
                "text": "干杯！还想聊点什么"
              },
              {
                "id": "goodbye",
                "text": "为新年，为希望！"
              }
            ]
          },
          {
            "id": "ask_newyear_fight",
            "text": "新年有特别的表演赛！不是生死搏斗，而是技艺展示。我会和几个老朋友一起表演，展示最精彩的剑术。晚上还有烟火...哦，你一定要去看！",
            "responses": [
              {
                "id": "ask_fireworks",
                "text": "罗马也有烟火？"
              },
              {
                "id": "watch_show",
                "text": "我一定去看您的表演！"
              },
              {
                "id": "goodbye",
                "text": "期待您的表演！"
              }
            ]
          },
          {
            "id": "ask_fireworks",
            "text": "当然！从东方传来的火药，能在夜空中绽放出最美的光芒。新年的夜晚，整个罗马城都会被五彩的光照亮。这是我最喜欢的新年传统！",
            "responses": [
              {
                "id": "watch_show",
                "text": "太期待了！"
              },
              {
                "id": "goodbye",
                "text": "新年快乐，再见！"
              }
            ]
          },
          {
            "id": "watch_show",
            "text": "（拍着你的肩膀）好！今晚斗兽场见！表演结束后，我们一起看烟火。新年要和朋友一起度过才有意义。记住，人生最重要的不是活多久，而是和谁一起活。",
            "responses": [
              {
                "id": "greeting",
                "text": "说得真好！还有其他话题吗？"
              },
              {
                "id": "goodbye",
                "text": "今晚见！新年快乐！"
              }
            ]
          },
          {
            "id": "ask_resolution",
            "text": "新年计划？（若有所思）我想开一家角斗学校，不是教人杀戮，而是教人强身健体、保护自己。还想...找一个能共度余生的人。哈哈，是不是有点贪心？",
            "responses": [
              {
                "id": "encourage_spartacus",
                "text": "这些愿望一定会实现的！"
              },
              {
                "id": "goodbye",
                "text": "祝您心想事成！"
              }
            ]
          },
          {
            "id": "encourage_spartacus",
            "text": "（爽朗地笑）谢谢你，朋友！新年就是要有梦想。来，这是我自酿的蜂蜜酒，送你作为新年礼物。愿你的新年也充满惊喜！",
            "responses": [
              {
                "id": "greeting",
