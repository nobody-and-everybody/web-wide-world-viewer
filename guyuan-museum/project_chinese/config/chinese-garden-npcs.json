    "list": [
        {
            "id": "npc_scholar_chen",
            "modelId": "scholar",
            "position": {
                "x": -9.74,
                "y": 1.89,
                "z": -0.25
            },
            "rotation": {
                "x": 0,
                "y": 59,
                "z": 0
            },
            "movementPattern": "idle",
            "interaction": {
                "type": "guide",
                "distance": 2.5,
                "autoTrigger": true,
                "hintText": "📜 新春贺岁",
                "dialogues": [
                    {
                        "id": "greeting",
                        "text": "（作揖）新春大吉！在下陈文远，一介书生。今日除夕，特来此园赏景，准备写几句诗词迎接新年。阁下也是来此过年的吗？",
                        "responses": [
                            {
                                "id": "ask_poem",
                                "text": "先生可否赋诗一首？"
                            },
                            {
                                "id": "ask_newyear_custom",
                                "text": "文人如何过新年？"
                            },
                            {
                                "id": "ask_garden",
                                "text": "这园林有何典故？"
                            },
                            {
                                "id": "goodbye",
                                "text": "新年快乐，陈先生"
                            }
                        ]
                    },
                    {
                        "id": "ask_poem",
                        "text": "（捋须沉吟）好！且听我即兴赋诗一首——'爆竹声中辞旧岁，梅花香里迎新春。园林亭台皆换彩，人间处处是温存。'如何？虽比不得古人，聊表新年之意。",
                        "responses": [
                            {
                                "id": "praise_poem",
                                "text": "好诗！意境深远！"
                            },
                            {
                                "id": "ask_meaning",
                                "text": "这诗有何深意？"
                            },
                            {
                                "id": "goodbye",
                                "text": "先生果然才高八斗！"
                            }
                        ]
                    },
                    {
                        "id": "praise_poem",
                        "text": "（欣慰）哈哈，承蒙夸奖。诗词乃心之所寄，新年作诗，是为记录此刻心情。来年再读，便能重温今日的喜悦。阁下不妨也试着写一首？",
                        "responses": [
                            {
                                "id": "try_poem",
                                "text": "我试试...新年到，人欢笑？"
                            },
                            {
                                "id": "decline_poem",
                                "text": "我不擅长作诗"
                            },
                            {
                                "id": "goodbye",
                                "text": "改日再向先生请教"
                            }
                        ]
                    },
                    {
                        "id": "try_poem",
                        "text": "（点头）'新年到，人欢笑'——好！朴实真切！诗词不在辞藻华丽，而在真情实感。阁下这句虽简，却道出了新年的真谛。来，再添两句？",
                        "responses": [
                            {
                                "id": "continue_poem",
                                "text": "红灯高挂门前照，爆竹声声除旧恼"
                            },
                            {
                                "id": "ask_help",
                                "text": "请先生帮我补全"
                            },
                            {
                                "id": "goodbye",
                                "text": "先生过奖了"
                            }
                        ]
                    },
                    {
                        "id": "continue_poem",
                        "text": "（击掌叫好）妙哉！'红灯高挂门前照，爆竹声声除旧恼'——对仗工整，意境喜庆！阁下有诗才！这首诗，我要记下来，作为今年新春的佳作！",
                        "responses": [
                            {
                                "id": "thank_scholar",
                                "text": "多谢先生指点！"
                            },
                            {
                                "id": "goodbye",
                                "text": "先生过奖了，新年快乐！"
                            }
                        ]
                    },
                    {
                        "id": "thank_scholar",
                        "text": "（从袖中取出一卷宣纸）这是我手书的'福'字，送与阁下。贴在门上，可保新年福运亨通。愿阁下新的一年，学业有成，事事如意！",
                        "responses": [
                            {
                                "id": "greeting",
                                "text": "太感谢了！还想再聊聊"
                            },
                            {
                                "id": "goodbye",
                                "text": "珍贵的礼物，多谢先生！"
                            }
                        ]
                    },
                    {
                        "id": "ask_help",
                        "text": "（思索）既然是新年，不如这样——'红灯映雪添瑞气，爆竹辞岁报新朝。'如此一来，便是一首完整的新春小诗了。阁下觉得如何？",
                        "responses": [
                            {
                                "id": "learn_poem",
                                "text": "先生教得好！"
                            },
                            {
                                "id": "goodbye",
                                "text": "受教了，新年快乐！"
                            }
                        ]
                    },
                    {
                        "id": "learn_poem",
                        "text": "（含笑）诗词之道，贵在多练。新年是最好的题材——喜庆、团圆、希望，皆可入诗。来年若有佳作，记得来与我分享。新年快乐！",
                        "responses": [
                            {
                                "id": "greeting",
                                "text": "一定！还想请教"
                            },
                            {
                                "id": "goodbye",
                                "text": "先生新年快乐！"
                            }
                        ]
                    },
                    {
                        "id": "decline_poem",
                        "text": "（摆手）无妨无妨。诗词是雅事，却不是必需。能感受新年的喜悦，便已足够。不过，若有机会，不妨试试。诗词能让快乐变得更长久。",
                        "responses": [
                            {
                                "id": "ask_newyear_custom",
                                "text": "那先生是如何过年的？"
                            },
                            {
                                "id": "goodbye",
                                "text": "说得有理，新年快乐！"
                            }
                        ]
                    },
                    {
                        "id": "ask_meaning",
                        "text": "这诗分四层：'爆竹声中辞旧岁'是告别过去；'梅花香里迎新春'是迎接未来；'园林亭台皆换彩'是景物焕新；'人间处处是温存'是人情温暖。诗以景传情，以情动人。",
                        "responses": [
                            {
                                "id": "praise_poem",
                                "text": "先生讲解得太好了！"
                            },
                            {
                                "id": "goodbye",
                                "text": "受教了！"
                            }
                        ]
                    },
                    {
                        "id": "ask_newyear_custom",
                        "text": "（捻须）文人过年，讲究'四雅'——写春联、作诗词、品香茗、赏梅花。除夕夜守岁时，与三五知己围炉畅谈，吟诗作对，直到天明。这是一年中最雅致的时刻。",
                        "responses": [
                            {
                                "id": "ask_couplet",
                                "text": "春联有何讲究？"
                            },
                            {
                                "id": "ask_shouxu",
                                "text": "守岁是什么？"
                            },
                            {
                                "id": "goodbye",
                                "text": "真是风雅！"
                            }
                        ]
                    },
                    {
                        "id": "ask_couplet",
                        "text": "春联是新年之魂！上联述旧岁，下联迎新春，横批点睛。要对仗工整，寓意吉祥。今年我写的是：'天增岁月人增寿，春满乾坤福满门'，横批'万象更新'。",
                        "responses": [
                            {
                                "id": "praise_couplet",
                                "text": "好联！"
                            },
                            {
                                "id": "goodbye",
                                "text": "先生墨宝，定是佳作！"
                            }
                        ]
                    },
                    {
                        "id": "praise_couplet",
                        "text": "（高兴）知音难觅！来，我现在就写一副送你——（挥毫泼墨）'龙腾四海迎新岁，福满人间庆有余'。挂在门上，保你新年龙马精神！",
                        "responses": [
                            {
                                "id": "greeting",
                                "text": "太珍贵了！还想多聊聊"
                            },
                            {
                                "id": "goodbye",
                                "text": "多谢先生墨宝！"
                            }
                        ]
                    },
                    {
                        "id": "ask_shouxu",
                        "text": "守岁是除夕夜不睡觉，等待新年到来。古人说'一夜连双岁，五更分二年'，守的是辞旧迎新的那一刻。点上红烛，全家团聚，是最温馨的时光。",
                        "responses": [
                            {
                                "id": "ask_wish",
                                "text": "先生今年有什么愿望？"
                            },
                            {
                                "id": "goodbye",
                                "text": "真是美好的传统！"
                            }
                        ]
                    },
                    {
                        "id": "ask_wish",
                        "text": "（眼神悠远）我的愿望？愿天下太平，百姓安乐。愿我的文章能开启民智，教化一方。也愿...来年金榜题名，不负寒窗苦读。哈哈，说起来倒有些私心了。",
                        "responses": [
                            {
                                "id": "bless_scholar",
                                "text": "先生定能高中！"
                            },
                            {
                                "id": "goodbye",
                                "text": "愿先生心想事成！"
                            }
                        ]
                    },
                    {
                        "id": "bless_scholar",
                        "text": "（作揖）承蒙吉言！来年若能金榜题名，定不忘今日知遇。阁下也是有福之人，新的一年，愿你所求皆如愿，所行皆坦途！",
                        "responses": [
                            {
                                "id": "greeting",
                                "text": "谢谢先生！还想再聊"
                            },
                            {
                                "id": "goodbye",
                                "text": "先生新年大吉！"
                            }
                        ]
                    },
                    {
                        "id": "ask_garden",
                        "text": "这座园林，名唤'怡然园'，已有三百年历史。亭台楼阁，皆仿江南园林而建。新年时节，园中会挂满红灯笼，梅花盛开，是赏景的绝佳之地。",
                        "responses": [
                            {
                                "id": "ask_spot",
                                "text": "有什么必看的景点？"
                            },
                            {
                                "id": "goodbye",
                                "text": "真是雅致！"
                            }
                        ]
                    },
                    {
                        "id": "ask_spot",
                        "text": "园中最美处，当属'望月亭'和'梅香径'。亭中可观池中锦鲤，径上梅花正盛。新年第一天，在梅花下许愿，据说特别灵验。阁下不妨一试。",
                        "responses": [
                            {
                                "id": "greeting",
                                "text": "谢谢指点！还想聊聊"
                            },
                            {
                                "id": "goodbye",
                                "text": "这就去看看！"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "npc_elder_wang",
            "modelId": "elder",
            "position": {
                "x": -8.6,
                "y": 1.79,
                "z": 8.84
            },
            "rotation": {
                "x": 0,
                "y": 100,
                "z": 0
            },
            "movementPattern": "idle",
            "interaction": {
                "type": "guide",
                "distance": 2.5,
                "autoTrigger": true,
                "hintText": "🏮 新春祝福",
                "dialogues": [
                    {
                        "id": "greeting",
                        "text": "（和蔼地）新年好啊，年轻人！老夫姓王，守护这座园林已有四十年了。今日除夕，你能来这里，便是有缘。来，让老夫给你讲讲新年的规矩。",
                        "responses": [
                            {
                                "id": "ask_rules",
                                "text": "新年有什么规矩？"
                            },
                            {
                                "id": "ask_tradition",
                                "text": "新年有哪些传统？"
                            },
                            {
                                "id": "ask_blessing",
                                "text": "请老伯赐福"
                            },
                            {
                                "id": "goodbye",
                                "text": "新年快乐，王老伯"
                            }
                        ]
                    },
                    {
                        "id": "ask_rules",
                        "text": "新年规矩多着呢！初一不扫地，怕扫走财气；不说不吉利的话，要多说'恭喜发财'、'万事如意'；见长辈要拜年磕头；小辈要给压岁钱...这些规矩，都是祖祖辈辈传下来的。",
                        "responses": [
                            {
                                "id": "ask_hongbao",
                                "text": "压岁钱有什么讲究？"
                            },
                            {
                                "id": "ask_taboo",
                                "text": "还有什么禁忌？"
                            },
                            {
                                "id": "goodbye",
                                "text": "原来如此，受教了"
                            }
                        ]
                    },
                    {
                        "id": "ask_hongbao",
                        "text": "压岁钱，是长辈给晚辈的祝福。'压岁'就是'压住邪祟'的意思，保佑孩子平安长大。红包要用红纸封好，数字要吉利，比如66、88、168，都是好意头。",
                        "responses": [
                            {
                                "id": "receive_hongbao",
                                "text": "老伯要给我压岁钱吗？"
                            },
                            {
                                "id": "ask_tradition",
                                "text": "还有什么新年传统？"
                            },
                            {
                                "id": "goodbye",
                                "text": "学到了，谢谢老伯！"
                            }
                        ]
                    },
                    {
                        "id": "receive_hongbao",
                        "text": "（哈哈大笑）你这孩子，倒是机灵！好，既然有缘，老夫就给你一个'福'字红包。（递过红包）拿着，新的一年，福气满满！",
                        "responses": [
                            {
                                "id": "thank_elder",
                                "text": "多谢老伯！恭祝老伯福如东海！"
                            },
                            {
                                "id": "goodbye",
                                "text": "谢谢老伯，新年快乐！"
                            }
                        ]
                    },
                    {
                        "id": "thank_elder",
                        "text": "（欣慰）好孩子，懂礼貌！老夫活了七十多岁，最看重的就是'礼'字。你有这份心，来年定有福报。去吧，好好过年，多陪陪家人。",
                        "responses": [
                            {
                                "id": "greeting",
                                "text": "好的，还想再聊聊"
                            },
                            {
                                "id": "goodbye",
                                "text": "老伯也要保重身体！"
                            }
                        ]
                    },
                    {
                        "id": "ask_taboo",
                        "text": "禁忌嘛...初一不动刀剪，怕有血光之灾；不打破碗碟，若打破了要说'岁岁平安'；不哭闹，不吵架，要和和气气。新年讨个好彩头，一年都顺遂。",
                        "responses": [
                            {
                                "id": "ask_suisui",
                                "text": "'岁岁平安'怎么讲？"
                            },
                            {
                                "id": "goodbye",
                                "text": "我记住了！"
                            }
                        ]
                    },
                    {
                        "id": "ask_suisui",
                        "text": "'岁'和'碎'同音，打碎东西说'岁岁平安'，就把坏事变成了好话。中国人讲究谐音，比如'鱼'代表'年年有余'，'苹果'代表'平平安安'。说话做事，都要往好处想。",
                        "responses": [
                            {
                                "id": "ask_tradition",
                                "text": "还有什么有趣的传统？"
                            },
                            {
                                "id": "goodbye",
                                "text": "中国文化真有意思！"
                            }
                        ]
                    },
                    {
                        "id": "ask_tradition",
                        "text": "新年传统可多了！除夕要吃团圆饭，一家人围坐在一起；要贴春联、挂灯笼；放鞭炮驱邪；看舞龙舞狮；还有最重要的——守岁！一家人聊天到天亮，迎接新年第一缕阳光。",
                        "responses": [
                            {
                                "id": "ask_reunion",
                                "text": "团圆饭有什么讲究？"
                            },
                            {
                                "id": "ask_dragon",
                                "text": "舞龙舞狮是什么？"
                            },
                            {
                                "id": "goodbye",
                                "text": "听起来好热闹！"
                            }
                        ]
                    },
                    {
                        "id": "ask_reunion",
                        "text": "团圆饭是一年中最重要的一顿饭！要有鱼——年年有余；要有饺子——形如元宝，招财进宝；要有年糕——年年高升；还要有汤圆——团团圆圆。每道菜都有寓意。",
                        "responses": [
                            {
                                "id": "ask_dumpling",
                                "text": "饺子为什么是元宝？"
                            },
                            {
                                "id": "ask_blessing",
                                "text": "老伯能给我一些祝福吗？"
                            },
                            {
                                "id": "goodbye",
                                "text": "真有讲究！"
                            }
                        ]
                    },
                    {
                        "id": "ask_dumpling",
                        "text": "饺子形状像古时候的金元宝，吃饺子就是'招财进宝'。而且饺子里可以包硬币，谁吃到谁就有财运。老夫年轻时，年年都能吃到，哈哈！",
                        "responses": [
                            {
                                "id": "ask_elder_wish",
                                "text": "老伯今年有什么愿望？"
                            },
                            {
                                "id": "goodbye",
                                "text": "老伯真是有福之人！"
                            }
                        ]
                    },
                    {
                        "id": "ask_dragon",
                        "text": "舞龙舞狮是新年最热闹的活动！龙是中国人的图腾，舞龙能带来好运。狮子能驱邪避凶，舞狮时锣鼓喧天，好不热闘。今晚城里就有舞龙表演，你要去看看！",
                        "responses": [
                            {
                                "id": "ask_time",
                                "text": "什么时候开始？"
                            },
                            {
                                "id": "goodbye",
                                "text": "我一定去看！"
                            }
                        ]
                    },
                    {
                        "id": "ask_time",
                        "text": "子时一过，也就是半夜十二点，舞龙队就从城门出发，一路舞到天亮。你跟着龙走，福气就跟着你走。记得带些糖果，撒给舞龙的人，讨个好彩头！",
                        "responses": [
                            {
                                "id": "greeting",
